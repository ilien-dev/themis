{
  "hooks": {
    "SessionStart": [
      { "hooks": [ { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/session-start.mjs\"", "timeout": 10 } ] }
    ],
    "PreToolUse": [
      { "matcher": "Edit|Write|MultiEdit",
        "hooks": [ { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/pre-tool.mjs\"", "timeout": 10 } ] },
      { "matcher": "Bash",
        "hooks": [ { "type": "command", "if": "Bash(*CLAUDE*)", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/pre-tool.mjs\"", "timeout": 10 } ] },
      { "matcher": "PowerShell",
        "hooks": [ { "type": "command", "if": "PowerShell(*CLAUDE*)", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/pre-tool.mjs\"", "timeout": 10 } ] }
    ]
  }
}
